<Window x:Class="TicketManager.Views.MetaInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手工输入" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI" FontSize="13" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Text="输入要设置的产品名称：" FontWeight="SemiBold" FontSize="14"/>
        <TextBox x:Name="NameBox" Margin="0,10,0,0" Padding="4" MaxLength="60"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="确定" Width="80" Padding="6,3" Click="Ok_Click" IsDefault="True"/>
            <Button Content="取消" Width="80" Padding="6,3" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
