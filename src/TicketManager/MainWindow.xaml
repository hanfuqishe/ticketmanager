        <StreamGeometry x:Key="IconEarth">M17.9,17.39C17.64,16.59 16.89,16 16,16H15V13A1,1 0 0,0 14,12H8V10H10A1,1 0 0,0 11,9V7H13A2,2 0 0,0 15,5V4.59C17.93,5.77 20,8.64 20,12C20,14.08 19.2,15.97 17.9,17.39M11,19.93C7.05,19.44 4,16.08 4,12C4,11.38 4.08,10.78 4.21,10.21L9,15V16A2,2 0 0,0 11,18M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z</StreamGeometry>
        <StreamGeometry x:Key="IconOffice">M12,7V3H2V21H22V7H12M6,19H4V17H6V19M6,15H4V13H6V15M6,11H4V9H6V11M6,7H4V5H6V7M10,19H8V17H10V19M10,15H8V13H10V15M10,11H8V9H10V11M10,7H8V5H10V7M20,19H12V17H14V15H12V13H14V11H12V9H20V19M18,11H16V13H18V11M18,15H16V17H18V15Z</StreamGeometry>
        <StreamGeometry x:Key="IconPackage">M20.84,5.61L20.03,4.1C19.75,3.57 19.21,3.28 18.6,3.28H5.4C4.79,3.28 4.25,3.57 3.97,4.1L3.16,5.61C3.05,5.82 3,6.04 3,6.26V7A1,1 0 0,0 4,8H20A1,1 0 0,0 21,7V6.26C21,6.04 20.95,5.82 20.84,5.61M7.5,7H4.81L5.5,5.5H8.27L7.5,7M20,14H16V13.75A1.75,1.75 0 0,0 14.25,12H9.75A1.75,1.75 0 0,0 8,13.75V14H4V19A1,1 0 0,0 5,20H19A1,1 0 0,0 20,19V14M8.5,9.5H15.5V10A0.5,0.5 0 0,1 15,10.5H9A0.5,0.5 0 0,1 8.5,10V9.5Z</StreamGeometry>
        <StreamGeometry x:Key="IconDoc">M13,9H18.5L13,3.5V9M6,2H14L20,8V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V4C4,2.89 4.89,2 6,2M15,18V16H6V18H15M18,14V12H6V14H18Z</StreamGeometry>
        <StreamGeometry x:Key="IconSearch">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</StreamGeometry>
        <StreamGeometry x:Key="IconCheck">M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z</StreamGeometry>
        <StreamGeometry x:Key="IconCopy">M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z</StreamGeometry>
        <StreamGeometry x:Key="IconSend">M2,21L23,12L2,3V10L17,12L2,14V21Z</StreamGeometry>
        <!-- 文档+加号：提新工单（新建文档） -->
        <StreamGeometry x:Key="IconDocNew">M14,2H6C4.9,2 4,2.9 4,4V20C4,21.1 4.9,22 6,22H18C19.1,22 20,21.1 20,20V8L14,2M13,9V3.5L18.5,9H13M13,16H11V18H9V16H7V14H9V12H11V14H13V16Z</StreamGeometry>
        <!-- 回复箭头：回复此邮件 -->
        <StreamGeometry x:Key="IconReply">M10,9V5L3,12L10,19V14.9C15,14.9 18.5,16.5 21,20C20,15 17,10 10,9Z</StreamGeometry>
        <StreamGeometry x:Key="IconStar">M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z</StreamGeometry>

        <!-- 按键栏按钮：默认淡/透明背景，悬停淡灰、按下略深，选中（勾选）时浅蓝+蓝边才醒目 -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E9EEF5"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD6E2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DCE4EE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 按键栏开关（仅新邮件/仅星标）：默认淡，勾选时浅蓝底+蓝边框突出 -->
        <Style x:Key="ToolbarToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E9EEF5"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CBD6E2"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D6E6FB"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2B7DE9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 展开/折叠箭头（三角形，展开时旋转 90° 指向下） -->
        <Style x:Key="TreeExpanderStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="16" Height="16" SnapsToDevicePixels="True">
                            <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 0 8 Z" Fill="#555"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 树形缩进虚线：每个层级左侧绘制一条贯穿该节点及子树的纵向虚线 -->
        <Style x:Key="TreeViewItemGuideStyle" TargetType="TreeViewItem">
            <!-- 双向绑定：用户手动展开/折叠会写回 VM，过滤重建树时才能保留实际折叠层次 -->
            <Setter Property="IsExpanded" Value="{Binding ExpandedByDefault, Mode=TwoWay}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="19"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 整行高亮层：横跨两列铺满整行，作为根/悬停/选中的底色；左侧竖条用于标记选中 -->
                            <Border x:Name="RowBg" Grid.Row="0" Grid.ColumnSpan="2"
                                    Background="Transparent" SnapsToDevicePixels="True">
                                <Border x:Name="SelBar" Width="3" HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch" Background="#2b7de9" Visibility="Collapsed"/>
                            </Border>

                            <!-- 纵向虚线：从本节点顶部贯穿到子树底部，展示缩进层级 -->
                            <Line Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                  X1="0.02" Y1="0" X2="0.02" Y2="1"
                                  Stretch="Fill" Stroke="#C8C8C8" StrokeThickness="1"
                                  StrokeDashArray="1.5 2.5"/>

                            <ToggleButton x:Name="Expander" Grid.Row="0" Grid.Column="0"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          Style="{StaticResource TreeExpanderStyle}"/>

                            <Border x:Name="Bd" Grid.Row="0" Grid.Column="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <!-- 根邮件（第 0 层）整行浅色高亮 -->
                            <DataTrigger Binding="{Binding Depth}" Value="0">
                                <Setter TargetName="RowBg" Property="Background" Value="#EAF3FD"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="#F2F2F2"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="#D6E8F7"/>
                                <Setter TargetName="SelBar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- Ctrl/Shift 多选：根线索高亮为深蓝 -->
                            <DataTrigger Binding="{Binding IsMultiSelected}" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="#B3D4FC"/>
                            </DataTrigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 只读正文框：凹陷 3D 边框 + 淡灰背景（表明不可编辑） -->
        <Style x:Key="SunkenTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#F6F6F6"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#8E8E8E"
                                BorderThickness="1" SnapsToDevicePixels="True">
                            <Border BorderBrush="#FFFFFF" BorderThickness="1">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type vm:CustomerGroupViewModel}" ItemsSource="{Binding Products}">
            <!-- 客户行：Grid 铺满整行（含右侧空白），行内任意位置右键都可弹出导出菜单 -->
            <Grid Margin="0,5,0,5" Background="Transparent">
                <Grid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Opened="GroupContextMenu_Opened">
                        <MenuItem Header="设置产品" Tag="{Binding}"/>
                        <MenuItem Header="设置客户" Tag="{Binding}"/>
                        <MenuItem Header="重命名企业…" Tag="{Binding}" Click="RenameEnterprise_Click"/>
                        <Separator/>
                        <MenuItem Header="全部已读" Tag="{Binding}" Click="GroupSeen_Click">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource IconCheck}" Fill="#43A047" Width="15" Height="15" Stretch="Uniform"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="导出本客户全部线索为 CSV" Tag="{Binding}" Click="ExportCsv_Click"/>
                        <MenuItem Header="导出本客户全部线索为 Excel" Tag="{Binding}" Click="ExportExcel_Click"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconOffice}" Fill="#E67E22" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CountText}" Foreground="Gray" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type vm:ProductGroupViewModel}" ItemsSource="{Binding Threads}">
            <!-- 产品行：Grid 铺满整行（含右侧空白），行内任意位置右键都可弹出导出菜单 -->
            <Grid Margin="0,5,0,5" Background="Transparent">
                <Grid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Opened="GroupContextMenu_Opened">
                        <MenuItem Header="设置产品" Tag="{Binding}"/>
                        <MenuItem Header="设置客户" Tag="{Binding}"/>
                        <Separator/>
                        <MenuItem Header="全部已读" Tag="{Binding}" Click="GroupSeen_Click">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource IconCheck}" Fill="#43A047" Width="15" Height="15" Stretch="Uniform"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="导出本产品全部线索为 CSV" Tag="{Binding}" Click="ExportCsv_Click"/>
                        <MenuItem Header="导出本产品全部线索为 Excel" Tag="{Binding}" Click="ExportExcel_Click"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <StackPanel Orientation="Horizontal">
                <!-- 匹配到产品 Logo 时显示图片；否则显示默认盒子图标 -->
                <Image Source="{Binding ProductLogo}" Width="24" Height="24" Stretch="Uniform"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProductLogo}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <Path Data="{StaticResource IconPackage}" Fill="#8E24AA" Width="22" Height="22" Stretch="Uniform"
                      VerticalAlignment="Center">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProductLogo}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CountText}" Foreground="Gray" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type vm:IgnoredGroupViewModel}" ItemsSource="{Binding Emails}">
            <!-- “已忽略的邮件”顶层大类：专门图标，被忽略邮件直接挂在其下（不虚构客户/产品分组） -->
            <Grid Margin="0,5,0,5" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconEyeOff}" Fill="#D9534F" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CountText}" Foreground="Gray" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type vm:EmailNodeViewModel}" ItemsSource="{Binding Children}">
            <!-- Grid 铺满整行，右键在行内任意位置（含文字右侧空白）都可弹出菜单（每封邮件都可用；线索级项仅根显示） -->
            <Grid Margin="2,1" Background="Transparent">
                <Grid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                 Opened="ContextMenu_Opened">
                        <MenuItem Header="回复此邮件" Tag="{Binding}" Click="ReplyTicket_Click">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource IconReply}" Fill="#1565C0" Width="15" Height="15" Stretch="Uniform"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="复制工单号" Tag="{Binding}" Click="CopyTicketNumber_Click">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource IconCopy}" Fill="#455A64" Width="15" Height="15" Stretch="Uniform"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="StarMenuItem" Header="星标" Tag="{Binding}" Click="ToggleStarMenu_Click">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource IconStar}" Fill="#F5A623" Width="15" Height="15" Stretch="Uniform"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="UploadLogMenu" Header="上传日志" Tag="{Binding}" Click="UploadLog_Click" IsEnabled="False">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource IconPaperclip}" Fill="#1565C0" Width="15" Height="15" Stretch="Uniform"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="IgnoreMenu" Header="忽略此邮件" Tag="{Binding}" Click="IgnoreEmail_Click">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource IconEyeOff}" Fill="#D9534F" Width="15" Height="15" Stretch="Uniform"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator x:Name="MetaSep1"/>
                        <MenuItem x:Name="SetStatusMenu" Header="设置状态">
                            <MenuItem Header="已解决" Tag="{Binding}" Click="SetStatus_Click"/>
                            <MenuItem Header="已关闭" Tag="{Binding}" Click="SetStatus_Click"/>
                            <MenuItem Header="处理中" Tag="{Binding}" Click="SetStatus_Click"/>
                            <MenuItem Header="等待客户回复" Tag="{Binding}" Click="SetStatus_Click"/>
                            <MenuItem Header="等待客服回复" Tag="{Binding}" Click="SetStatus_Click"/>
                            <MenuItem Header="纳入开发计划" Tag="{Binding}" Click="SetStatus_Click"/>
                            <MenuItem Header="合并或拆分为其他工单" Tag="{Binding}" Click="SetStatus_Click"/>
                            <MenuItem Header="新建" Tag="{Binding}" Click="SetStatus_Click"/>
                            <Separator/>
                            <MenuItem Header="AI 总结" Tag="{Binding}" Click="RegenerateStatus_Click" InputGestureText="F9"/>
                        </MenuItem>
                        <MenuItem x:Name="MarkSeenMenuItem" Header="全部已读" Tag="{Binding}" Click="MarkThreadSeen_Click">
                            <MenuItem.Icon>
                                <Path Data="{StaticResource IconCheck}" Fill="#43A047" Width="15" Height="15" Stretch="Uniform"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator x:Name="MetaSep2"/>
                        <MenuItem x:Name="SetProductMenu" Header="设置产品" Tag="{Binding}"/>
                        <MenuItem x:Name="SetCustomerMenu" Header="设置客户" Tag="{Binding}"/>
                        <Separator x:Name="MetaSep3"/>
                        <MenuItem x:Name="ClearMetaMenuItem" Header="清空产品/客户" Tag="{Binding}" Click="ClearMeta_Click"/>
                    </ContextMenu>
                </Grid.ContextMenu>
                <StackPanel>
                    <!-- 行1：状态徽章 + 标题（占满剩余）+ 星标固定在行右边缘，各行星标纵向对齐成竖线 -->
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Background="Transparent" BorderThickness="0" Padding="3,0"
                                VerticalAlignment="Center" Click="ToggleStar_Click" ToolTip="标星/取消星标">
                            <Path Data="{StaticResource IconStar}" Width="13" Height="13" Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="#C9C9C9"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStarred}" Value="True">
                                                <Setter Property="Fill" Value="#F5A623"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{Binding StatusBrush}" CornerRadius="3" Padding="4,1" VerticalAlignment="Center"
                                    Visibility="{Binding IsRoot, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11"/>
                            </Border>
                            <Border Background="#E67E22" CornerRadius="3" Padding="4,1" VerticalAlignment="Center" Margin="4,0,0,0"
                                    Visibility="{Binding NewBadgeVisibility}">
                                <TextBlock Text="NEW" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="4,0,0,0"
                                       FontWeight="{Binding TitleWeight}">
                                <Run Text="{Binding Badge, Mode=OneWay}" Foreground="#2b7de9" FontWeight="Bold"/>
                                <Run Text="{Binding Title, Mode=OneWay}" Foreground="#202020"/>
                                <Run Text="{Binding SummaryPrefix, Mode=OneWay}" Foreground="{Binding SummaryBrush}" FontWeight="SemiBold"/>
                                <Run Text="{Binding Summary, Mode=OneWay}" Foreground="{Binding SummaryBrush}"/>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                    <!-- 行2：工单号（仅根邮件） 发件人 · 时间 -->
                    <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                        <TextBlock Text="{Binding TicketPrefix, Mode=OneWay}" FontSize="11" Foreground="#1f3a5f" FontWeight="SemiBold"
                                   Visibility="{Binding IsRoot, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding Sender, Mode=OneWay}" FontSize="11" Foreground="{Binding SenderBrush}"/>
                        <TextBlock Text="·" FontSize="11" Foreground="Gray" Margin="4,0"/>
                        <TextBlock Text="{Binding Time, Mode=OneWay}" FontSize="11" Foreground="Gray"/>
                    </StackPanel>
                    <!-- 行间虚线分隔 -->
                    <Rectangle Height="1" Stroke="#D0D0D0" StrokeThickness="1" StrokeDashArray="2 2" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- 主菜单 -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="工单(_G)">
                <MenuItem Header="提新工单(_N)" Command="{Binding SubmitTicketCommand}" InputGestureText="Ctrl+N">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconDocNew}" Fill="#43A047" Width="15" Height="15" Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="同步邮件(_S)" Command="{Binding SyncCommand}" InputGestureText="Ctrl+S">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconSync}" Fill="#2B7DE9" Width="15" Height="15" Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="停止同步(_T)" Command="{Binding StopSyncCommand}">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconStop}" Fill="#D9534F" Width="15" Height="15" Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="清空本地数据(_C)" Command="{Binding ClearDataCommand}" InputGestureText="Ctrl+Shift+Delete">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconDelete}" Fill="#D9534F" Width="15" Height="15" Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="导出线索(_E)">
                    <MenuItem x:Name="ExportCsvMenuItem" Header="导出全部线索为 CSV" Click="ExportAllCsv_Click">
                        <MenuItem.Icon>
                            <Path Data="{StaticResource IconDoc}" Fill="#009688" Width="15" Height="15" Stretch="Uniform"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem x:Name="ExportExcelMenuItem" Header="导出全部线索为 Excel" Click="ExportAllExcel_Click">
                        <MenuItem.Icon>
                            <Path Data="{StaticResource IconDoc}" Fill="#1E88E5" Width="15" Height="15" Stretch="Uniform"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <Separator/>
                <MenuItem Header="退出(_X)" Click="Exit_Click">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconLogout}" Fill="#7F8C8D" Width="15" Height="15" Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="设置(_S)">
                <MenuItem Header="设置…(_O)" Command="{Binding OpenSettingsCommand}" InputGestureText="Ctrl+,">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconCog}" Fill="#5B9BD5" Width="15" Height="15" Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="签名…(_G)" Command="{Binding SignaturesCommand}">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconDoc}" Fill="#5B9BD5" Width="15" Height="15" Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="字体…(_F)" Command="{Binding FontSettingsCommand}">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconPalette}" Fill="#5B9BD5" Width="15" Height="15" Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="导航(_N)">
                <MenuItem Header="跳转新邮件(_J)" Command="{Binding JumpToNewMailCommand}" InputGestureText="Ctrl+J">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconEmail}" Fill="#2B7DE9" Width="15" Height="15" Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="视图(_V)">
                <MenuItem Header="智能整理（折叠已结束、展开进行中）" Click="SmartCollapse_Click">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconCheck}" Fill="#43A047" Width="15" Height="15" Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <!-- 过滤：仅新邮件 / 仅星标 / 清除检索 -->
                <MenuItem Header="仅显示新邮件" IsCheckable="True" IsChecked="{Binding NewMailOnly}">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconEmail}" Fill="#43A047" Width="15" Height="15" Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="仅显示星标" IsCheckable="True" IsChecked="{Binding StarredOnly}">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconStar}" Fill="#F5A623" Width="15" Height="15" Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>
                <!-- 仅打开工单：隐藏 已解决/已完成/已关闭/合并或拆分为其他工单 的线索 -->
                <MenuItem Header="仅显示打开的工单" IsCheckable="True" IsChecked="{Binding OpenOnly}">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconCheck}" Fill="#2B7DE9" Width="15" Height="15" Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="显示被忽略的邮件" IsCheckable="True" IsChecked="{Binding ShowIgnored}">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconEyeOff}" Fill="#D9534F" Width="15" Height="15" Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="清除检索" Click="ClearSearch_Click">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconSearch}" Fill="#757575" Width="15" Height="15" Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="检索…" Click="FocusSearch_Click" InputGestureText="Ctrl+F">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconSearch}" Fill="#2B7DE9" Width="15" Height="15" Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <!-- 一次性动作：点击只展开到目标层次，不做勾选、不持久化为状态；之后展开状态由用户操作决定 -->
                <MenuItem Header="只显示用户名称" Tag="1" Click="SetExpandDepth_Click"/>
                <MenuItem Header="显示到产品名称" Tag="2" Click="SetExpandDepth_Click"/>
                <MenuItem Header="显示到线索首邮件" Tag="3" Click="SetExpandDepth_Click"/>
                <MenuItem Header="显示所有邮件" Tag="4" Click="SetExpandDepth_Click"/>
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="关于…(_A)" Click="About_Click">
                    <MenuItem.Icon>
                        <Path Data="{StaticResource IconInfo}" Fill="#2B7DE9" Width="15" Height="15" Stretch="Uniform"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- 按键栏：通栏横跨整个窗口，所有快捷按钮在一行内全部显示 -->
        <Border DockPanel.Dock="Top" Padding="8,6" Background="#fafafa" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding SubmitTicketCommand}" Style="{StaticResource ToolbarButtonStyle}"
                        MinWidth="88" Padding="10,3"
                        FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"
                        ToolTip="提新工单（Ctrl+N）">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconDocNew}" Fill="#43A047" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text=" 提新工单" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Path Data="{StaticResource IconSearch}" Fill="#757575" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBox x:Name="SearchBox" Width="190" Margin="6,0,0,0" Padding="4" VerticalAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="按工单号或邮件主题检索，留空显示全部"/>
                <Button Content="✕" Width="24" Padding="0" Margin="4,0,0,0"
                        VerticalAlignment="Center" ToolTip="清除检索" Click="ClearSearch_Click"
                        Style="{StaticResource ToolbarButtonStyle}"/>
                <Border Width="1" Background="#C8C8C8" Margin="8,3,0,3"/>
                <ToggleButton IsChecked="{Binding NewMailOnly}" Style="{StaticResource ToolbarToggleButtonStyle}"
                              MinWidth="82" Padding="8,3"
                              FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                              ToolTip="只显示含有新同步邮件的线索">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconEmail}" Fill="#43A047" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text=" 仅新邮件" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding StarredOnly}" Style="{StaticResource ToolbarToggleButtonStyle}"
                              MinWidth="82" Padding="8,3"
                              FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                              ToolTip="只显示含有星标邮件的线索">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconStar}" Fill="#F5A623" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text=" 仅星标" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton IsChecked="{Binding OpenOnly}" Style="{StaticResource ToolbarToggleButtonStyle}"
                              MinWidth="82" Padding="8,3"
                              FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                              ToolTip="只显示打开的工单（隐藏 已解决/已关闭/已合并到其他工单）">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCheck}" Fill="#43A047" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text=" 仅打开" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>
                <Border Width="1" Background="#C8C8C8" Margin="8,3,0,3"/>
                <Button Command="{Binding JumpToNewMailCommand}" Style="{StaticResource ToolbarButtonStyle}"
                        MinWidth="104" Padding="10,3"
                        FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                        ToolTip="跳到下一条新同步的邮件（Ctrl+J）">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconEmail}" Fill="#2B7DE9" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text=" 跳转新邮件" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SyncCommand}" Style="{StaticResource ToolbarButtonStyle}"
                        MinWidth="72" Padding="10,3"
                        FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                        ToolTip="同步邮件（Ctrl+S）">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconSync}" Fill="#1565C0" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text=" 同步" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- 底部状态栏 -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="140" Height="8" VerticalAlignment="Center" Margin="0,0,6,0"
                                 Minimum="0" Maximum="100" Value="{Binding ProgressValue}"
                                 IsIndeterminate="{Binding ProgressIndeterminate}" Visibility="{Binding BusyVisibility}"/>
                    <TextBlock Text="{Binding ProgressPercentText}" Foreground="#1f3a5f" FontWeight="SemiBold"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                               Visibility="{Binding BusyVisibility}"/>
                    <TextBlock Text="{Binding StatusText}"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding DbPath}" Foreground="Gray" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>

        <!-- 主体：左树右详情（分隔条位于右侧 1/3） -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="380"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="1*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <!-- ItemsSource 由代码在 DataContext 就绪后构建 CompositeCollection（正常客户分组 + “已忽略的邮件”大类），
                     XAML 内联绑定时 DataContext 尚为 null 会导致 CollectionContainer 绑定失效、树空白 -->
                <TreeView x:Name="TreeView"
                          ItemContainerStyle="{StaticResource TreeViewItemGuideStyle}"
                          SelectedItemChanged="TreeView_SelectedItemChanged"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          BorderThickness="0" BorderBrush="#e0e0e0">
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#e8e8e8"/>

            <DockPanel Grid.Column="2" Margin="14">
                <!-- 按钮行：固定在底部，不随正文伸缩 -->
                <Grid DockPanel.Dock="Bottom" Margin="0,4,0,0" Height="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ExpandQuoteButton" Grid.Column="0" Click="ExpandQuote_Click" MinWidth="84"
                            Padding="10,3" FontSize="11" VerticalAlignment="Center"
                            Visibility="Collapsed" ToolTip="展开被引用的历史邮件">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPaperclip}" Fill="#5B9BD5" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text=" 展开引用" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Command="{Binding TranslateEmailCommand}" MinWidth="88" Padding="12,3"
                            FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"
                            ToolTip="交给 AI 翻译邮件正文">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconEarth}" Fill="#43A047" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TranslateButtonText}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 内容区：总结 / 标题 / 元信息 / 正文 -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="60"/>
                    </Grid.RowDefinitions>

                    <!-- 工单智能总结 -->
                    <Border Grid.Row="0" Background="{Binding SelectedSummaryBackground}" BorderBrush="{Binding SelectedSummaryBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDoc}" Fill="#009688" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedThreadHeader}" FontSize="15" FontWeight="Bold" Foreground="#1f3a5f"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedThreadSummary}" TextWrapping="Wrap" Margin="2,8,0,0" Foreground="#333"/>
                            <TextBlock Text="{Binding SelectedStatusReasonDisplay}" TextWrapping="Wrap" Margin="2,8,0,0"
                                       Foreground="#8a5a00" FontWeight="SemiBold"
                                       Visibility="{Binding HasStatusReason, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>

                    <!-- 邮件详情 -->
                    <TextBox Grid.Row="1" Text="{Binding SelectedEmailTitle, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                             TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             Padding="0" IsTabStop="False"/>
                    <!-- 邮件元信息 -->
                    <StackPanel Grid.Row="2" Margin="0,4,0,6">
                        <TextBlock Text="{Binding SelectedEmailMeta}" Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
                        <!-- 附件区：始终显示。有附件 → 可点击的附件名按钮；无附件 → “（无附件）”提示 -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Path Data="{StaticResource IconPaperclip}" Fill="#1565C0" Width="13" Height="13"
                                  Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text=" 附件：" FontSize="12" FontWeight="SemiBold" Foreground="#555"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="（无附件）" FontSize="12" Foreground="#999" VerticalAlignment="Center"
                                       Visibility="{Binding HasNoAttachments, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding SelectedEmailAttachments}" Margin="24,-2,0,0"
                                      Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 附件项：双击打开；右键菜单可“打开/保存” -->
                                    <Border Background="Transparent" CornerRadius="3" Padding="7,2" Margin="0,2,6,2"
                                            Cursor="Hand" ToolTip="双击打开附件；右键可打开或另存为">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftDoubleClick"
                                                          Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Border.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="打开" Tag="{Binding}" Click="OpenAttachmentMenu_Click">
                                                    <MenuItem.Icon>
                                                        <Path Data="{StaticResource IconEarth}" Fill="#43A047" Width="15" Height="15" Stretch="Uniform"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="保存…" Tag="{Binding}" Click="SaveAttachmentMenu_Click">
                                                    <MenuItem.Icon>
                                                        <Path Data="{StaticResource IconDoc}" Fill="#1E88E5" Width="15" Height="15" Stretch="Uniform"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconPaperclip}" Fill="#1565C0" Width="13" Height="13"
                                                  Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding}" Margin="4,0,0,0" VerticalAlignment="Center"
                                                       MaxWidth="300" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <!-- 正文：RichTextBox 支持 正文/引用 分色显示（引用部分灰色斜体 + 分隔线）；字体来自配置（主菜单 设置→字体…） -->
                    <Border Grid.Row="3" BorderBrush="#c8c8c8" BorderThickness="1" Background="White" CornerRadius="3">
                        <RichTextBox x:Name="EmailBodyBox" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                                     FontFamily="{Binding EmailFontFamily}" FontSize="{Binding EmailFontSize}"
                                     BorderThickness="0" Padding="8" IsTabStop="False" Background="Transparent"/>
                    </Border>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
