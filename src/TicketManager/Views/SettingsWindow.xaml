<Window x:Class="TicketManager.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="560" Width="680"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI" FontSize="13"
        ResizeMode="CanResize">
    <Window.Resources>
        <StreamGeometry x:Key="IconEmail">M20,4H4C2.9,4 2,4.9 2,6V18C2,19.1 2.9,20 4,20H20C21.1,20 22,19.1 22,18V6C22,4.9 21.1,4 20,4M20,8L12,13L4,8V6L12,11L20,6V8Z</StreamGeometry>
        <StreamGeometry x:Key="IconDoc">M13,9H18.5L13,3.5V9M6,2H14L20,8V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V4C4,2.89 4.89,2 6,2M15,18V16H6V18H15M18,14V12H6V14H18Z</StreamGeometry>
    </Window.Resources>
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存" Width="90" Padding="8,4" Click="Save_Click" IsDefault="True"/>
            <Button Content="取消" Width="90" Padding="8,4" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>

        <TabControl>
            <!-- ===== 同步设置（原 IMAP，已迁移 Zoho REST；仅保留通用同步项）===== -->
            <TabItem Header="同步设置">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="首次同步：" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="8,4">
                        <TextBox Text="{Binding Config.FirstSyncDays}" Width="90" Padding="4" VerticalAlignment="Center"/>
                        <TextBlock Text="天内的邮件" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <CheckBox Content="自动收取新邮件" IsChecked="{Binding Config.EnableAutoSync}" VerticalAlignment="Center" Margin="24,0,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="数据文件：" VerticalAlignment="Top" Margin="0,6,0,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DbPath, Mode=OneWay}" IsReadOnly="True" Margin="8,4" Padding="4" Foreground="Gray"/>
                </Grid>
            </TabItem>

            <!-- ===== 客服邮箱 ===== -->
            <TabItem Header="关注的客服邮箱">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="以下邮箱地址出现在邮件往来中时，该邮件才会被纳入监控（可配置多个）："
                               TextWrapping="Wrap" Foreground="#555"/>
                    <ListBox x:Name="AddressList" Grid.Row="1" ItemsSource="{Binding MonitoredAddresses}" Margin="0,10"
                             BorderBrush="#ccc">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconEmail}" Fill="#2B7DE9" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <TextBox Text="{Binding NewAddress, UpdateSourceTrigger=PropertyChanged}" Width="320" Padding="4"
                                 VerticalAlignment="Center"/>
                        <Button Content="添加" Command="{Binding AddAddressCommand}" Margin="8,0,0,0" Padding="12,4"/>
                        <Button Content="删除选中" Command="{Binding RemoveAddressCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=AddressList}"
                                Margin="8,0,0,0" Padding="12,4"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===== 域名→企业 ===== -->
            <TabItem Header="域名→企业">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="配置邮箱域名后缀与企业名称的对应关系（如 want-want.com → 旺旺集团）。当邮件主题分析不出企业时，会从发件/收件/抄送地址的域名按此映射推断企业（报障邮件抄送客户时尤其有效）。"
                               TextWrapping="Wrap" Foreground="#555"/>
                    <ListBox x:Name="MappingList" Grid.Row="1" ItemsSource="{Binding DomainMappings}" Margin="0,10"
                             BorderBrush="#ccc">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#1f3a5f"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <TextBox Text="{Binding NewDomain, UpdateSourceTrigger=PropertyChanged}" Width="180" Padding="4"
                                 VerticalAlignment="Center" ToolTip="邮箱域名后缀，如 want-want.com"/>
                        <TextBlock Text=" → " VerticalAlignment="Center" Margin="4,0"/>
                        <TextBox Text="{Binding NewEnterprise, UpdateSourceTrigger=PropertyChanged}" Width="180" Padding="4"
                                 VerticalAlignment="Center" ToolTip="企业名称，如 旺旺集团"/>
                        <Button Content="添加" Command="{Binding AddMappingCommand}" Margin="8,0,0,0" Padding="12,4"/>
                        <Button Content="删除选中" Command="{Binding RemoveMappingCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=MappingList}"
                                Margin="8,0,0,0" Padding="12,4"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===== DeepSeek ===== -->
            <TabItem Header="DeepSeek AI">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="API Key：" VerticalAlignment="Center"/>
                    <PasswordBox x:Name="DeepSeekKeyBox" Grid.Row="0" Grid.Column="1" Margin="8,4" Padding="4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="接口地址：" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.DeepSeekBaseUrl}" Margin="8,4" Padding="4"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="模型：" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.DeepSeekModel}" Margin="8,4" Padding="4"/>

                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="8,6">
                        <CheckBox Content="为每封邮件生成一句话标题" IsChecked="{Binding Config.EnableAiTitle}" Margin="0,0,20,0"/>
                        <CheckBox Content="为工单智能总结状态" IsChecked="{Binding Config.EnableAiStatus}" Margin="0,0,20,0"/>
                        <CheckBox Content="主题未标注时用 AI 分析产品/客户" IsChecked="{Binding Config.EnableAiMeta}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===== 代理 ===== -->
            <TabItem Header="网络代理">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Grid.Column="1" Content="启用代理" IsChecked="{Binding Config.UseProxy}" Margin="8,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="类型：" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ProxyTypes}"
                              SelectedIndex="{Binding SelectedProxyIndex}" Margin="8,4" Width="140" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="地址：" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.ProxyHost}" Margin="8,4" Padding="4"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="端口：" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Config.ProxyPort}" Margin="8,4" Padding="4" Width="120" HorizontalAlignment="Left"/>

                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="8,8">
                        <CheckBox Content="用于 DeepSeek 接口" IsChecked="{Binding Config.ProxyForDeepSeek}" Margin="0,0,20,0"/>
                        <CheckBox Content="用于 Zoho REST API" IsChecked="{Binding Config.ProxyForZoho}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===== 其他 ===== -->
            <TabItem Header="其他">
                <StackPanel Margin="16">
                    <StackPanel Orientation="Horizontal" Margin="0,6">
                        <TextBlock Text="单封邮件发送给 AI 的最大字符数：" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding Config.MaxBodyChars}" Width="90" Padding="4" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="说明：邮件正文过长时将被截断后再发送给 DeepSeek，以避免超出上下文限制。" 
                               Foreground="#888" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </TabItem>
            <!-- ===== Zoho REST API ===== -->
            <TabItem Header="Zoho REST API">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 凭据输入区 -->
                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="API 地址：" Width="110" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Config.ZohoApiBase}" Width="280" Padding="4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Client ID：" Width="110" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="ZohoClientIdBox" Width="280" Padding="4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Client Secret：" Width="110" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="ZohoClientSecretBox" Width="280" Padding="4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Refresh Token：" Width="110" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="ZohoRefreshTokenBox" Width="280" Padding="4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Account ID：" Width="110" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Config.ZohoAccountId}" Width="280" Padding="4"/>
                            <TextBlock Text="留空自动获取" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="测试连接" Padding="16,4" Click="TestZoho_Click"/>
                            <TextBlock x:Name="ZohoTestText" VerticalAlignment="Center" Margin="12,0,0,0"
                                       TextWrapping="Wrap" MaxWidth="440" Foreground="#333"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 分步骤配置说明（含可点击链接） -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                        <Border BorderBrush="#dce6f0" BorderThickness="1" CornerRadius="6" Padding="14" Background="#f8fafc">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDoc}" Fill="#009688" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="配置步骤（只需一次，蓝色文字可点击打开）" FontWeight="Bold" FontSize="14" Foreground="#1f3a5f" Margin="6,0,0,0"/>
                                </StackPanel>

                                <TextBlock Text="① 创建客户端，获取 Client ID / Client Secret" FontWeight="Bold" Margin="0,12,0,0"/>
                                <TextBlock TextWrapping="Wrap" LineHeight="21" Margin="0,4,0,0">
                                    <Run Text="打开　"/>
                                    <Hyperlink NavigateUri="https://api-console.zoho.com/" RequestNavigate="Link_RequestNavigate">Zoho API Console（点此打开）</Hyperlink>
                                    <Run Text="　并用 Zoho 账号登录 → 右上角 ADD CLIENT → 类型选 Self Client → CREATE。创建后复制页面上的 "/><Run Text="Client ID"/><Run Text=" 和 "/><Run Text="Client Secret"/><Run Text="。"/>
                                </TextBlock>

                                <TextBlock Text="② 生成 Refresh Token（长期有效）" FontWeight="Bold" Margin="0,12,0,0"/>
                                <TextBlock TextWrapping="Wrap" LineHeight="21" Margin="0,4,0,0">
                                    <Run Text="在客户端页面点击 Generate Token，把下面这行 Scope 粘贴进去（逗号分隔）→ 生成 → 复制 "/><Run Text="Refresh Token"/><Run Text="（线程信息由 messages.READ 自动返回，无需单独申请）："/>
                                </TextBlock>
                                <DockPanel Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Right" Content="复制" Padding="14,4" Margin="8,0,0,0"
                                            VerticalAlignment="Center" Click="CopyScope_Click"
                                            ToolTip="把 Scope 复制到剪贴板"/>
                                    <TextBox Text="ZohoMail.accounts.READ,ZohoMail.folders.READ,ZohoMail.messages.READ"
                                             IsReadOnly="True" FontFamily="Consolas" Foreground="#1f3a5f"
                                             TextWrapping="Wrap" Padding="6"
                                             Background="#eef2f7" BorderBrush="#c8d4e0"
                                             ToolTip="可选中复制，或点右侧「复制」按钮"/>
                                </DockPanel>

                                <TextBlock Text="③ 填入本页并测试连接" FontWeight="Bold" Margin="0,12,0,0"/>
                                <TextBlock TextWrapping="Wrap" LineHeight="21" Margin="0,4,0,0">
                                    <Run Text="把上一步的 "/><Run Text="Client ID"/><Run Text="、"/><Run Text="Client Secret"/><Run Text="、"/><Run Text="Refresh Token"/><Run Text=" 填入上方；API 地址用 "/><Hyperlink NavigateUri="https://mail.zoho.com/api" RequestNavigate="Link_RequestNavigate">https://mail.zoho.com/api</Hyperlink><Run Text="（美国数据中心）；Account ID 留空即可自动获取。最后点击 "/><Run Text="测试连接"/><Run Text=" 验证凭据是否可用。"/>
                                </TextBlock>

                                <TextBlock Text="④ 数据中心（与你的 Zoho 区域一致）" FontWeight="Bold" Margin="0,12,0,0"/>
                                <TextBlock TextWrapping="Wrap" LineHeight="21" Margin="0,4,0,0">
                                    <Run Text="美国：认证　"/>
                                    <Hyperlink NavigateUri="https://accounts.zoho.com" RequestNavigate="Link_RequestNavigate">accounts.zoho.com</Hyperlink>
                                    <Run Text="　　　API　"/>
                                    <Hyperlink NavigateUri="https://mail.zoho.com/api" RequestNavigate="Link_RequestNavigate">https://mail.zoho.com/api</Hyperlink>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" LineHeight="21" Margin="0,2,0,0">
                                    <Run Text="中国：认证　"/>
                                    <Hyperlink NavigateUri="https://accounts.zoho.com.cn" RequestNavigate="Link_RequestNavigate">accounts.zoho.com.cn</Hyperlink>
                                    <Run Text="　　　API　"/>
                                    <Hyperlink NavigateUri="https://mail.zoho.com.cn/api" RequestNavigate="Link_RequestNavigate">https://mail.zoho.com.cn/api</Hyperlink>
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="0,14,0,0" Foreground="#888" FontSize="11">
                                    <Run Text="安全提示：Client ID / Secret / Refresh Token 属敏感信息，程序会用 Windows DPAPI 加密存储，请勿提交到代码仓库。"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
