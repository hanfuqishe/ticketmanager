<Window x:Class="TicketManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TicketManager.ViewModels"
        Title="工单邮件管理器" Height="780" Width="1240"
        Icon="pack://application:,,,/TicketManager.ico"
        WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 展开/折叠箭头（三角形，展开时旋转 90° 指向下） -->
        <Style x:Key="TreeExpanderStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Width="16" Height="16" SnapsToDevicePixels="True">
                            <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 0 8 Z" Fill="#555"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 树形缩进虚线：每个层级左侧绘制一条贯穿该节点及子树的纵向虚线 -->
        <Style x:Key="TreeViewItemGuideStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="19"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 整行高亮层：横跨两列铺满整行，作为根/悬停/选中的底色 -->
                            <Border x:Name="RowBg" Grid.Row="0" Grid.ColumnSpan="2"
                                    Background="Transparent" SnapsToDevicePixels="True"/>

                            <!-- 纵向虚线：从本节点顶部贯穿到子树底部，展示缩进层级 -->
                            <Line Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                  X1="0.02" Y1="0" X2="0.02" Y2="1"
                                  Stretch="Fill" Stroke="#C8C8C8" StrokeThickness="1"
                                  StrokeDashArray="1.5 2.5"/>

                            <ToggleButton x:Name="Expander" Grid.Row="0" Grid.Column="0"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          Style="{StaticResource TreeExpanderStyle}"/>

                            <Border x:Name="Bd" Grid.Row="0" Grid.Column="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <!-- 根邮件（第 0 层）整行浅色高亮 -->
                            <DataTrigger Binding="{Binding Depth}" Value="0">
                                <Setter TargetName="RowBg" Property="Background" Value="#EAF3FD"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="#F2F2F2"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="#D6E8F7"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="HasItems" Value="False"/>
                                    <Condition Property="IsExpanded" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type vm:CustomerGroupViewModel}" ItemsSource="{Binding Products}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🏢" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CountText}" Foreground="Gray" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type vm:ProductGroupViewModel}" ItemsSource="{Binding Threads}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="📦" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding CountText}" Foreground="Gray" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type vm:ThreadViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <Border Background="{Binding StatusBrush}" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11"/>
                </Border>
                <TextBlock Text="{Binding Header}" VerticalAlignment="Center" Margin="8,0,0,0"
                           TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                <TextBlock Text="{Binding Summary}" Foreground="Gray" FontSize="11" VerticalAlignment="Center"
                           Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
            </StackPanel>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type vm:EmailNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Margin="2,1">
                <TextBlock TextWrapping="NoWrap">
                    <Run Text="{Binding Badge, Mode=OneWay}" Foreground="#2b7de9" FontWeight="Bold"/>
                    <Run Text="{Binding Title, Mode=OneWay}" Foreground="#202020"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                    <TextBlock Text="{Binding Sender, Mode=OneWay}" FontSize="11"
                               Foreground="{Binding SenderBrush}"/>
                    <TextBlock Text="·" FontSize="11" Foreground="Gray" Margin="4,0"/>
                    <TextBlock Text="{Binding Time, Mode=OneWay}" FontSize="11" Foreground="Gray"/>
                </StackPanel>
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top" Background="#f3f3f3" BorderBrush="#dddddd" BorderThickness="0,0,0,1" Padding="10,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="⟳ 同步" Command="{Binding SyncCommand}" Padding="14,5" FontSize="13"/>
                <Button Content="⚙ 设置" Command="{Binding OpenSettingsCommand}" Padding="14,5" FontSize="13" Margin="10,0,0,0"/>
                <Button Content="🗑 清空数据" Command="{Binding ClearDataCommand}" Padding="14,5" FontSize="13" Margin="10,0,0,0" Foreground="#c0392b"/>
                <ComboBox ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedSort}"
                          Width="150" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <ProgressBar Width="180" Height="6" Margin="18,0,0,0" VerticalAlignment="Center"
                             IsIndeterminate="{Binding IsBusy}" Visibility="{Binding BusyVisibility}"/>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#444"/>
            </StackPanel>
        </Border>

        <!-- 底部状态栏 -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding DbPath}" Foreground="Gray" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>

        <!-- 主体：左树右详情 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="380"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="3*" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <TreeView Grid.Column="0" ItemsSource="{Binding Customers}"
                      ItemContainerStyle="{StaticResource TreeViewItemGuideStyle}"
                      SelectedItemChanged="TreeView_SelectedItemChanged"
                      BorderThickness="0,0,1,0" BorderBrush="#e0e0e0">
            </TreeView>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#e8e8e8"/>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14">
                    <!-- 工单智能总结 -->
                    <Border Background="#f7f9fc" BorderBrush="#dde6f0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋 " FontSize="14"/>
                                <TextBlock Text="{Binding SelectedThreadHeader}" FontSize="15" FontWeight="Bold" Foreground="#1f3a5f"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedThreadSummary}" TextWrapping="Wrap" Margin="2,8,0,0" Foreground="#333"/>
                        </StackPanel>
                    </Border>

                    <!-- 邮件详情 -->
                    <TextBlock Text="{Binding SelectedEmailTitle}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SelectedEmailMeta}" Foreground="Gray" FontSize="12" Margin="0,4,0,8"
                               TextWrapping="Wrap"/>
                    <TextBox Text="{Binding SelectedEmailBody, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" AcceptsReturn="True" Height="400"
                             FontFamily="Microsoft YaHei UI" FontSize="12" Padding="6" BorderBrush="#ddd"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
