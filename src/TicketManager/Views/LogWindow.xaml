<Window x:Class="TicketManager.Views.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="运行日志" Height="460" Width="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI" FontSize="12">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="#888" FontSize="11"
                   Text="记录窗口最下行（状态栏）显示过的全部信息，带时间戳；最多保留最近 20000 条。" TextWrapping="Wrap"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="复制全部" Width="90" Padding="8,4" Click="CopyAll_Click"/>
            <Button Content="清空" Width="90" Padding="8,4" Margin="10,0,0,0" Click="Clear_Click"/>
            <Button Content="关闭" Width="90" Padding="8,4" Margin="10,0,0,0" Click="Close_Click"/>
        </StackPanel>

        <ListBox x:Name="LogList" ItemsSource="{Binding Logs}" BorderBrush="#ccc"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Time}" Foreground="#888" Width="64" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="6,0,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
