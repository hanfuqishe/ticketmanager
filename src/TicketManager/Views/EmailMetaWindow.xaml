<Window x:Class="TicketManager.Views.EmailMetaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置产品与客户" Height="240" Width="400"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI" FontSize="13" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="产品（从已标注的列表中选择）："/>
        <ComboBox x:Name="ProductBox" IsEditable="False" Margin="0,4,0,0" Padding="4"/>

        <TextBlock Text="客户企业（从列表中选择）：" Margin="0,12,0,0"/>
        <ComboBox x:Name="EnterpriseBox" IsEditable="False" Margin="0,4,0,0" Padding="4"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="确定" Width="80" Padding="6,3" Click="Ok_Click" IsDefault="True"/>
            <Button Content="取消" Width="80" Padding="6,3" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
