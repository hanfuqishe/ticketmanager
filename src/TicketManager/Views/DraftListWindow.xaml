<Window x:Class="TicketManager.Views.DraftListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="本地草稿" Height="430" Width="660"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Foreground="#888" FontSize="11"
                   Text="本机保存的草稿（提新工单 / 回复邮件）。双击或选“载入”把内容填回编辑窗口；草稿只存本机（%AppData%\TicketManager\drafts.json）。"
                   TextWrapping="Wrap"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="载入" Width="90" Padding="8,4" Click="Load_Click" IsDefault="True"/>
            <Button Content="删除" Width="90" Padding="8,4" Margin="10,0,0,0" Click="Delete_Click"/>
            <Button Content="关闭" Width="90" Padding="8,4" Margin="10,0,0,0" Click="Close_Click"/>
        </StackPanel>

        <ListBox x:Name="DraftList" BorderBrush="#ccc" MouseDoubleClick="DraftList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,3">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#EAF3FD" CornerRadius="3" Padding="5,1">
                                <TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="#1f3a5f"/>
                            </Border>
                            <TextBlock Text="{Binding SavedAt}" Foreground="#888" FontSize="11" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Title}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Title}"/>
                        <TextBlock Foreground="#777" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                            <Run Text="收件人："/><Run Text="{Binding To}"/>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
