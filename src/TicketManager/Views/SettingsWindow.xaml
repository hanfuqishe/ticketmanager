<Window x:Class="TicketManager.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="560" Width="680"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI" FontSize="13"
        ResizeMode="CanResize">
    <Window.Resources>
        <StreamGeometry x:Key="IconEmail">M20,4H4C2.9,4 2,4.9 2,6V18C2,19.1 2.9,20 4,20H20C21.1,20 22,19.1 22,18V6C22,4.9 21.1,4 20,4M20,8L12,13L4,8V6L12,11L20,6V8Z</StreamGeometry>
        <StreamGeometry x:Key="IconDoc">M13,9H18.5L13,3.5V9M6,2H14L20,8V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V4C4,2.89 4.89,2 6,2M15,18V16H6V18H15M18,14V12H6V14H18Z</StreamGeometry>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存" Width="90" Padding="8,4" Click="Save_Click" IsDefault="True"/>
            <Button Content="取消" Width="90" Padding="8,4" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>

        <TabControl x:Name="MainTab">
            <!-- ===== 同步设置（原 IMAP，已迁移 Zoho REST；仅保留通用同步项）===== -->
            <TabItem Header="同步设置">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="同步方式：" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,4">
                        <ComboBox ItemsSource="{Binding SyncModes}" SelectedItem="{Binding SelectedSyncMode}" Padding="2"/>
                        <TextBlock Text="自动：配了 Zoho REST 则用 Zoho，否则用 IMAP；也可强制指定其中一种" Foreground="#888" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="首次同步：" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="8,4">
                        <TextBox Text="{Binding Config.FirstSyncDays}" Width="90" Padding="4" VerticalAlignment="Center"/>
                        <TextBlock Text="天内的邮件" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <CheckBox Content="自动收取新邮件" IsChecked="{Binding Config.EnableAutoSync}" VerticalAlignment="Center" Margin="24,0,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="下载并发：" VerticalAlignment="Top" Margin="0,8,0,0"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding Config.SyncConcurrency}" Width="90" Padding="4" VerticalAlignment="Center"/>
                            <TextBlock Text="（1~10，默认 5）" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#888"/>
                        </StackPanel>
                        <TextBlock Text="⚠ 并发下载会同时建立多条连接，数值过大可能触发邮箱服务器的限流甚至封禁，请谨慎设置。" Foreground="#C62828" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="数据文件：" VerticalAlignment="Top" Margin="0,6,0,0"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DbPath, Mode=OneWay}" IsReadOnly="True" Margin="8,4" Padding="4" Foreground="Gray"/>
                </Grid>
            </TabItem>

            <!-- ===== 客服邮箱 ===== -->
            <TabItem Header="关注的客服邮箱">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="以下邮箱地址出现在邮件往来中时，该邮件才会被纳入监控（可配置多个）："
                               TextWrapping="Wrap" Foreground="#555"/>
                    <ListBox x:Name="AddressList" Grid.Row="1" ItemsSource="{Binding MonitoredAddresses}" Margin="0,10"
                             BorderBrush="#ccc">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconEmail}" Fill="#2B7DE9" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <TextBox Text="{Binding NewAddress, UpdateSourceTrigger=PropertyChanged}" Width="320" Padding="4"
                                 VerticalAlignment="Center"/>
                        <Button Content="添加" Command="{Binding AddAddressCommand}" Margin="8,0,0,0" Padding="12,4"/>
                        <Button Content="删除选中" Command="{Binding RemoveAddressCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=AddressList}"
                                Margin="8,0,0,0" Padding="12,4"/>
                    </StackPanel>
                    <CheckBox Grid.Row="3" IsChecked="{Binding Config.AutoTrackSupportMailboxes}"
                              Margin="0,12,0,0" Foreground="#555">
                        <TextBlock Text="自动发现客服邮箱：扫描邮件时，发件/收件/抄送中，凡 @ 前包含 “support”、且 @ 后包含 “manageengine” 或 “zohocorp” 的邮箱地址自动加入关注（如 mdm-support@manageengine.com、support@zohocorp.com.cn）"
                                   TextWrapping="Wrap"/>
                    </CheckBox>
                    <Border Grid.Row="4" Margin="0,10,0,0" Padding="10,6" CornerRadius="4"
                            Background="#FFF4E5" BorderBrush="#FFD9A0" BorderThickness="1"
                            Visibility="{Binding IsMonitoredEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="⚠ 关注列表为空：同步会采集邮件往来中出现的全部邮件（不限客服邮箱）。若邮件量很大，建议先加入客服邮箱地址后再同步。"
                                   TextWrapping="Wrap" Foreground="#9A6700" FontSize="11"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===== 我方支持域名（同事邮箱） ===== -->
            <TabItem Header="我方域名（同事）">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="配置我方支持人员（同事）邮箱的 @ 后缀域名。邮件往来中出现这些域名的账户会被视为「我方」（[我]），AI 归纳工单状态时不会把它们误当客户。多个域名用分号或逐个添加，如 manageengine.cn、zohomail.com"
                               TextWrapping="Wrap" Foreground="#555"/>
                    <ListBox x:Name="SupportDomainList" Grid.Row="1" ItemsSource="{Binding MySupportDomains}" Margin="0,10"
                             BorderBrush="#ccc">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconEmail}" Fill="#43A047" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <TextBox Text="{Binding NewSupportDomain, UpdateSourceTrigger=PropertyChanged}" Width="320" Padding="4"
                                 VerticalAlignment="Center" ToolTip="邮箱域名后缀，如 manageengine.cn"/>
                        <Button Content="添加" Command="{Binding AddSupportDomainCommand}" Margin="8,0,0,0" Padding="12,4"/>
                        <Button Content="删除选中" Command="{Binding RemoveSupportDomainCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=SupportDomainList}"
                                Margin="8,0,0,0" Padding="12,4"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===== 域名→企业 ===== -->
            <TabItem Header="域名→企业">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="配置邮箱域名后缀与企业名称的对应关系（如 want-want.com → 旺旺集团）。当邮件主题分析不出企业时，会从发件/收件/抄送地址的域名按此映射推断企业（报障邮件抄送客户时尤其有效）。"
                               TextWrapping="Wrap" Foreground="#555"/>
                    <ListBox x:Name="MappingList" Grid.Row="1" ItemsSource="{Binding DomainMappings}" Margin="0,10"
                             BorderBrush="#ccc">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#1f3a5f"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <TextBox Text="{Binding NewDomain, UpdateSourceTrigger=PropertyChanged}" Width="180" Padding="4"
                                 VerticalAlignment="Center" ToolTip="邮箱域名后缀，如 want-want.com"/>
                        <TextBlock Text=" → " VerticalAlignment="Center" Margin="4,0"/>
                        <TextBox Text="{Binding NewEnterprise, UpdateSourceTrigger=PropertyChanged}" Width="180" Padding="4"
                                 VerticalAlignment="Center" ToolTip="企业名称，如 旺旺集团"/>
                        <Button Content="添加" Command="{Binding AddMappingCommand}" Margin="8,0,0,0" Padding="12,4"/>
                        <Button Content="删除选中" Command="{Binding RemoveMappingCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=MappingList}"
                                Margin="8,0,0,0" Padding="12,4"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===== 产品简称 ===== -->
            <TabItem Header="产品简称">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="配置主题解析时“产品简称 → 产品全称”的对应关系（内置已有 EC→Endpoint Central、OPM→OPManager）。新增产品只需在此添加，例如 ue → UEM Central；主题/长标题中出现该简称即被规范为全称。"
                               TextWrapping="Wrap" Foreground="#555"/>
                    <ListBox x:Name="AliasList" Grid.Row="1" ItemsSource="{Binding ProductAliasItems}" Margin="0,10"
                             BorderBrush="#ccc">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#1f3a5f"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <TextBox Text="{Binding NewAliasShort, UpdateSourceTrigger=PropertyChanged}" Width="150" Padding="4"
                                 VerticalAlignment="Center" ToolTip="产品简称，如 ue"/>
                        <TextBlock Text=" → " VerticalAlignment="Center" Margin="4,0"/>
                        <TextBox Text="{Binding NewAliasFull, UpdateSourceTrigger=PropertyChanged}" Width="210" Padding="4"
                                 VerticalAlignment="Center" ToolTip="产品全称，如 UEM Central"/>
                        <Button Content="添加" Command="{Binding AddAliasCommand}" Margin="8,0,0,0" Padding="12,4"/>
                        <Button Content="删除选中" Command="{Binding RemoveAliasCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=AliasList}"
                                Margin="8,0,0,0" Padding="12,4"/>
                    </StackPanel>
                    <TextBlock Grid.Row="3" TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="0,8,0,0"
                               Text="保存后即时生效；已同步邮件需下次「同步」重新解析主题后按新简称归一（已手工指定产品/客户的不会被覆盖）。"/>
                </Grid>
            </TabItem>

            <!-- ===== 主流 AI（OpenAI 兼容接口） ===== -->
            <TabItem Header="AI 设置">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="AI 提供商：" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,4">
                        <ComboBox ItemsSource="{Binding AiProviders}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedAiProvider}" Padding="2"/>
                        <TextBlock Text="选择提供商自动填入接口地址与模型（可手动修改）；「自定义」保留当前填写"
                                   Foreground="#888" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="API Key：" VerticalAlignment="Center"/>
                    <PasswordBox x:Name="DeepSeekKeyBox" Grid.Row="1" Grid.Column="1" Margin="8,4" Padding="4"
                                 ToolTip="所选 AI 提供商的 API Key（在对应开放平台创建）"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="接口地址：" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.DeepSeekBaseUrl}" Margin="8,4" Padding="4"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="模型：" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Config.DeepSeekModel}" Margin="8,4" Padding="4"/>

                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="8,6">
                        <CheckBox Content="为每封邮件生成一句话标题" IsChecked="{Binding Config.EnableAiTitle}" Margin="0,0,20,0"/>
                        <CheckBox Content="为工单智能总结状态" IsChecked="{Binding Config.EnableAiStatus}" Margin="0,0,20,0"/>
                        <CheckBox Content="主题未标注时用 AI 分析产品/客户" IsChecked="{Binding Config.EnableAiMeta}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="8,6">
                        <TextBlock Text="单封邮件发送给 AI 的最大字符数：" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding Config.MaxBodyChars}" Width="90" Padding="4" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="（超长正文截断后再发送，避免超出上下文限制）" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- 通用说明 + 主流提供商一览 -->
                    <ScrollViewer Grid.Row="6" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                        <Border BorderBrush="#dce6f0" BorderThickness="1" CornerRadius="6" Padding="14" Background="#f8fafc">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDoc}" Fill="#009688" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="如何配置 AI（支持主流 OpenAI 兼容提供商）" FontWeight="Bold" FontSize="14" Foreground="#1f3a5f" Margin="6,0,0,0"/>
                                </StackPanel>

                                <TextBlock TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,0">
                                    ① 在上方选择「AI 提供商」，接口地址与默认模型会自动填入（可手动修改）；② 到该提供商的开放平台创建 API Key 填入「API Key」；③ 点击「保存」。程序内置的标题/状态总结/AI 分析/翻译都会调用所选 AI。
                                </TextBlock>

                                <TextBlock Text="主流提供商一览（均为 OpenAI 兼容接口）：" FontWeight="SemiBold" Margin="0,14,0,0"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="230"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="提供商" FontWeight="Bold" Foreground="#1f3a5f" FontSize="11"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="开放平台" FontWeight="Bold" Foreground="#1f3a5f" FontSize="11"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="默认模型" FontWeight="Bold" Foreground="#1f3a5f" FontSize="11"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="DeepSeek" FontSize="11"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="platform.deepseek.com" FontSize="11"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="deepseek-chat" FontSize="11"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="OpenAI" FontSize="11"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="platform.openai.com" FontSize="11"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="gpt-4o-mini" FontSize="11"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="通义千问（阿里云）" FontSize="11"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="bailian.aliyun.com" FontSize="11"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="qwen-plus" FontSize="11"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Kimi（月之暗面）" FontSize="11"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="platform.moonshot.cn" FontSize="11"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="moonshot-v1-8k" FontSize="11"/>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="智谱 GLM" FontSize="11"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="open.bigmodel.cn" FontSize="11"/>
                                    <TextBlock Grid.Row="5" Grid.Column="2" Text="glm-4-flash" FontSize="11"/>
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="豆包（火山方舟）" FontSize="11"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="console.volcengine.com/ark" FontSize="11"/>
                                    <TextBlock Grid.Row="6" Grid.Column="2" Text="doubao-seed-1-6-250615" FontSize="11"/>
                                </Grid>

                                <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="0,12,0,0" Foreground="#888" FontSize="11">
                                    安全提示：API Key 属敏感信息，程序会用 Windows DPAPI 加密存储，请勿提交到代码仓库。
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ===== 代理 ===== -->
            <TabItem Header="网络代理">
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Grid.Column="1" Content="启用代理" IsChecked="{Binding Config.UseProxy}" Margin="8,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="类型：" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ProxyTypes}"
                              SelectedIndex="{Binding SelectedProxyIndex}" Margin="8,4" Width="140" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="地址：" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.ProxyHost}" Margin="8,4" Padding="4"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="端口：" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Config.ProxyPort}" Margin="8,4" Padding="4" Width="120" HorizontalAlignment="Left"/>

                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="8,8">
                        <CheckBox Content="用于 AI 接口" IsChecked="{Binding Config.ProxyForDeepSeek}" Margin="0,0,20,0"/>
                        <CheckBox Content="用于 Zoho REST API" IsChecked="{Binding Config.ProxyForZoho}" Margin="0,0,20,0"/>
                        <CheckBox Content="用于 IMAP" IsChecked="{Binding Config.ProxyForImap}"/>
                        <CheckBox Content="用于 SMTP 发送" IsChecked="{Binding Config.ProxyForSmtp}" Margin="20,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="8,8">
                        <Button Content="测试连接" Padding="16,4" Click="TestProxy_Click"/>
                        <TextBlock x:Name="ProxyTestText" VerticalAlignment="Center" Margin="12,0,0,0"
                                   TextWrapping="Wrap" MaxWidth="460" Foreground="#333"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===== Zoho REST API ===== -->
            <TabItem Header="Zoho REST API">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 凭据输入区 -->
                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="API 地址：" Width="110" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Config.ZohoApiBase}" Width="280" Padding="4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Client ID：" Width="110" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="ZohoClientIdBox" Width="280" Padding="4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Client Secret：" Width="110" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="ZohoClientSecretBox" Width="280" Padding="4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Refresh Token：" Width="110" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="ZohoRefreshTokenBox" Width="280" Padding="4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Account ID：" Width="110" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Config.ZohoAccountId}" Width="280" Padding="4"/>
                            <TextBlock Text="留空自动获取" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="测试连接" Padding="16,4" Click="TestZoho_Click"/>
                            <TextBlock x:Name="ZohoTestText" VerticalAlignment="Center" Margin="12,0,0,0"
                                       TextWrapping="Wrap" MaxWidth="440" Foreground="#333"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 分步骤配置说明（含可点击链接） -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                        <Border BorderBrush="#dce6f0" BorderThickness="1" CornerRadius="6" Padding="14" Background="#f8fafc">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDoc}" Fill="#009688" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="配置步骤（只需一次，蓝色文字可点击打开）" FontWeight="Bold" FontSize="14" Foreground="#1f3a5f" Margin="6,0,0,0"/>
                                </StackPanel>

                                <TextBlock Text="① 创建客户端，获取 Client ID / Client Secret" FontWeight="Bold" Margin="0,12,0,0"/>
                                <TextBlock TextWrapping="Wrap" LineHeight="21" Margin="0,4,0,0">
                                    <Run Text="打开　"/>
                                    <Hyperlink NavigateUri="https://api-console.zoho.com/" RequestNavigate="Link_RequestNavigate">Zoho API Console（点此打开）</Hyperlink>
                                    <Run Text="　并用 Zoho 账号登录 → 右上角 ADD CLIENT → 类型选 Self Client → CREATE。创建后复制页面上的 "/><Run Text="Client ID"/><Run Text=" 和 "/><Run Text="Client Secret"/><Run Text="。"/>
                                </TextBlock>

                                <TextBlock Text="② 生成 Refresh Token（长期有效）" FontWeight="Bold" Margin="0,12,0,0"/>
                                <TextBlock TextWrapping="Wrap" LineHeight="21" Margin="0,4,0,0">
                                    <Run Text="在客户端页面点击 Generate Token，把下面这行 Scope 粘贴进去（逗号分隔）→ 生成 → 复制 "/><Run Text="Refresh Token"/><Run Text="（线程信息由 messages.READ 自动返回，无需单独申请；提新工单发信需要 messages.CREATE）："/>
                                </TextBlock>
                                <DockPanel Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Right" Content="复制" Padding="14,4" Margin="8,0,0,0"
                                            VerticalAlignment="Center" Click="CopyScope_Click"
                                            ToolTip="把 Scope 复制到剪贴板"/>
                                    <TextBox Text="ZohoMail.accounts.READ,ZohoMail.folders.READ,ZohoMail.messages.READ,ZohoMail.messages.CREATE"
                                             IsReadOnly="True" FontFamily="Consolas" Foreground="#1f3a5f"
                                             TextWrapping="Wrap" Padding="6"
                                             Background="#eef2f7" BorderBrush="#c8d4e0"
                                             ToolTip="可选中复制，或点右侧「复制」按钮"/>
                                </DockPanel>

                                <TextBlock Text="③ 填入本页并测试连接" FontWeight="Bold" Margin="0,12,0,0"/>
                                <TextBlock TextWrapping="Wrap" LineHeight="21" Margin="0,4,0,0">
                                    <Run Text="把上一步的 "/><Run Text="Client ID"/><Run Text="、"/><Run Text="Client Secret"/><Run Text="、"/><Run Text="Refresh Token"/><Run Text=" 填入上方；API 地址用 "/><Hyperlink NavigateUri="https://mail.zoho.com/api" RequestNavigate="Link_RequestNavigate">https://mail.zoho.com/api</Hyperlink><Run Text="（美国数据中心）；Account ID 留空即可自动获取。最后点击 "/><Run Text="测试连接"/><Run Text=" 验证凭据是否可用。"/>
                                </TextBlock>

                                <TextBlock Text="④ 数据中心（与你的 Zoho 区域一致）" FontWeight="Bold" Margin="0,12,0,0"/>
                                <TextBlock TextWrapping="Wrap" LineHeight="21" Margin="0,4,0,0">
                                    <Run Text="美国：认证　"/>
                                    <Hyperlink NavigateUri="https://accounts.zoho.com" RequestNavigate="Link_RequestNavigate">accounts.zoho.com</Hyperlink>
                                    <Run Text="　　　API　"/>
                                    <Hyperlink NavigateUri="https://mail.zoho.com/api" RequestNavigate="Link_RequestNavigate">https://mail.zoho.com/api</Hyperlink>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" LineHeight="21" Margin="0,2,0,0">
                                    <Run Text="中国：认证　"/>
                                    <Hyperlink NavigateUri="https://accounts.zoho.com.cn" RequestNavigate="Link_RequestNavigate">accounts.zoho.com.cn</Hyperlink>
                                    <Run Text="　　　API　"/>
                                    <Hyperlink NavigateUri="https://mail.zoho.com.cn/api" RequestNavigate="Link_RequestNavigate">https://mail.zoho.com.cn/api</Hyperlink>
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="0,14,0,0" Foreground="#888" FontSize="11">
                                    <Run Text="安全提示：Client ID / Secret / Refresh Token 属敏感信息，程序会用 Windows DPAPI 加密存储，请勿提交到代码仓库。"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ===== IMAP（任选/备用同步方式） ===== -->
            <TabItem Header="IMAP">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="服务器：" Width="110" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Config.ImapHost}" Width="280" Padding="4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="端口：" Width="110" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Config.ImapPort}" Width="120" Padding="4"/>
                            <CheckBox Content="使用 SSL" IsChecked="{Binding Config.ImapUseSsl}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="账号：" Width="110" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Config.ImapUsername}" Width="280" Padding="4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="密码/授权码：" Width="110" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="ImapPasswordBox" Width="280" Padding="4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="收件箱：" Width="110" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Config.ImapFolder}" Width="280" Padding="4"/>
                            <TextBlock Text="如 INBOX" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="发件箱：" Width="110" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Config.ImapSentFolder}" Width="280" Padding="4"/>
                            <TextBlock Text="留空自动识别" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="测试连接" Padding="16,4" Click="TestImap_Click"/>
                            <TextBlock x:Name="ImapTestText" VerticalAlignment="Center" Margin="12,0,0,0"
                                       TextWrapping="Wrap" MaxWidth="440" Foreground="#333"/>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="110,10,0,0">
                            注：Zoho Mail 已封禁普通 IMAP 登录；若你的邮箱被限制，请在「同步设置」选择「Zoho REST API」。其他支持 IMAP 的邮箱可用此方式。
                        </TextBlock>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                        <Border BorderBrush="#dce6f0" BorderThickness="1" CornerRadius="6" Padding="14" Background="#f8fafc">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconDoc}" Fill="#009688" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="IMAP 说明" FontWeight="Bold" FontSize="14" Foreground="#1f3a5f" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,0">
                                    IMAP 是直接登录邮箱服务器同步，无需申请 API 凭据。填写 服务器/端口/账号/密码 后，在「同步设置」把「同步方式」选为 IMAP 即可。Zoho Mail 出于安全已封禁普通 IMAP 密码登录，若你的 Zoho 邮箱无法用 IMAP 连接，请改用「Zoho REST API」方式。
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="0,12,0,0" Foreground="#888" FontSize="11">
                                    安全提示：邮箱密码属敏感信息，程序会用 Windows DPAPI 加密存储，请勿提交到代码仓库。
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="SMTP 发送">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="SMTP 服务器：" Width="110" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Config.SmtpHost}" Width="280" Padding="4"/>
                            <TextBlock Text="如 smtp.qq.com" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="端口：" Width="110" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Config.SmtpPort}" Width="120" Padding="4"/>
                            <CheckBox Content="使用 SSL" IsChecked="{Binding Config.SmtpUseSsl}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBlock Text="465=SSL；取消 SSL 常用 587" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="账号：" Width="110" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Config.SmtpUsername}" Width="280" Padding="4"/>
                            <TextBlock Text="留空=用 IMAP 账号" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="密码/授权码：" Width="110" VerticalAlignment="Center"/>
                            <PasswordBox x:Name="SmtpPasswordBox" Width="280" Padding="4"/>
                            <TextBlock Text="留空=用 IMAP 密码" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Gray" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="测试连接" Padding="16,4" Click="TestSmtp_Click"/>
                            <TextBlock x:Name="SmtpTestText" VerticalAlignment="Center" Margin="12,0,0,0"
                                       TextWrapping="Wrap" MaxWidth="460" Foreground="#333"/>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="#888" FontSize="11" Margin="110,10,0,0">
                            注：提新工单 / 回复邮件 的发送优先走 Zoho REST API；未配置 Zoho 时回退用此 SMTP。
                        </TextBlock>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                        <Border BorderBrush="#dce6f0" BorderThickness="1" CornerRadius="6" Padding="14" Background="#f8fafc">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconEmail}" Fill="#1565C0" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="SMTP 发送说明" FontWeight="Bold" FontSize="14" Foreground="#1f3a5f" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" LineHeight="21" Margin="0,12,0,0">
                                    用于在未配置 Zoho REST API（或使用 IMAP 同步）时发送「提新工单 / 回复邮件」。账号密码留空时自动复用「IMAP」页的账号与密码；如两者都留空，则尝试匿名发送（多数服务器会拒绝）。
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="0,12,0,0" Foreground="#888" FontSize="11">
                                    若需走代理，请在「网络代理」勾选“用于 SMTP 发送”。安全提示：SMTP 密码与邮箱密码一样以 DPAPI 加密存储。
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
