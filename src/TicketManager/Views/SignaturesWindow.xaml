<Window x:Class="TicketManager.Views.SignaturesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="签名管理" Height="560" Width="760"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI" FontSize="13"
        ResizeMode="CanResize">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock Text="保存后，提新工单窗口即可选择对应签名" VerticalAlignment="Center" Foreground="Gray" FontSize="11" Margin="0,0,16,0"/>
            <Button Content="保存" Width="90" Padding="8,4" Click="Save_Click" IsDefault="True"/>
            <Button Content="取消" Width="90" Padding="8,4" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：签名列表 -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="添加" Click="Add_Click" Padding="12,4"/>
                    <Button Content="删除" Click="Delete_Click" Padding="12,4" Margin="8,0,0,0"/>
                </StackPanel>
                <ListBox x:Name="SignatureList" ItemsSource="{Binding Signatures}" DisplayMemberPath="Name"
                         BorderBrush="#ccc"/>
            </DockPanel>

            <GridSplitter Grid.Column="1"/>

            <!-- 右：编辑当前签名（字体/字号/颜色统一用“设置→字体…”里的全局邮件字体设置） -->
            <Grid Grid.Column="2" Margin="12,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="名称：" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding SelectedItem.Name, ElementName=SignatureList, UpdateSourceTrigger=PropertyChanged}"
                         Margin="8,4" Padding="4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="内容：" VerticalAlignment="Top" Margin="0,6,0,0"/>
                <TextBox Grid.Row="1" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" MinHeight="150" Margin="8,4" Padding="4"
                         Text="{Binding SelectedItem.Text, ElementName=SignatureList, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="签名文本，发送时追加到邮件正文末尾（支持多行）"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
