<Window x:Class="TicketManager.Views.ReplyTicketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="回复邮件" Height="640" Width="620"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI" FontSize="13"
        ResizeMode="CanResize">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#C62828"
                       TextWrapping="Wrap" MaxWidth="380" FontSize="12"/>
            <Button Content="发送" Width="90" Padding="8,4" Command="{Binding SendCommand}" IsDefault="True"
                    HorizontalAlignment="Right"/>
            <Button Content="取消" Width="90" Padding="8,4" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="回复对象：" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Recipients}" DisplayMemberPath="Label"
                      SelectedItem="{Binding SelectedRecipient}" Margin="8,4" Padding="2"
                      ToolTip="客服=厂商技术支持；客户接口人=客户方联系人；另一个自动作为抄送"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="抄送：" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CcDisplay}" Foreground="Gray"
                       TextWrapping="Wrap" Margin="8,4" VerticalAlignment="Center"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="邮件标题：" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}"
                     Margin="8,4" Padding="4"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="回复内容：" VerticalAlignment="Top" Margin="0,6,0,0"/>
            <DockPanel Grid.Row="3" Grid.Column="1" Margin="8,4">
                <Button DockPanel.Dock="Top" Content="翻译为英文" Command="{Binding TranslateCommand}"
                        HorizontalAlignment="Right" Padding="10,3" FontSize="11" Margin="0,0,0,6"
                        ToolTip="把正文（及含中文的标题）翻译成英文"/>
                <TextBox Text="{Binding Body}" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Padding="4" MinHeight="140"
                         FontFamily="{Binding EmailFontFamily}" FontSize="{Binding EmailFontSize}"
                         ToolTip="回复内容；点“翻译为英文”可自动翻译"/>
            </DockPanel>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="引用：" VerticalAlignment="Top" Margin="0,6,0,0"/>
            <Border Grid.Row="4" Grid.Column="1" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="1"
                    CornerRadius="3" Padding="8" Margin="8,4" MaxHeight="120">
                <TextBlock Text="{Binding QuoteHeader}" Foreground="#888" FontSize="11" TextWrapping="Wrap"
                           VerticalAlignment="Top"/>
            </Border>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="签名：" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding SignatureNames}"
                      SelectedItem="{Binding Signature}" Padding="2" Margin="8,4"
                      ToolTip="在“设置→签名”中维护；发送时以 HTML 追加到正文末尾（留空则不追加）"/>
        </Grid>
    </DockPanel>
</Window>
